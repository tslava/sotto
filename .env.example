# Copy to .env and fill in. .env is never committed and never travels through CI.

# Bot token from BotFather (/newbot). Required.
BOT_TOKEN=

# Telegram user_id of the owner (a number). Owner commands (/status, /set, /say, ...) work
# only in a private chat with this account. 0 or empty disables them (WARNING at start).
ADMIN_USER_ID=

# ID of the one group chat the bot may work in. Messages from any other chat are dropped
# before anything is written to the database or the model is called.
#
# Discovery mode: while the value is 0 (or unset) the bot writes NOTHING to the database and
# answers nothing; it only logs, at WARNING level, the chat_id, chat title, user_id and
# display_name of every incoming message. Add the bot to the target chat, write something
# there, find the chat_id in the log of the first run, put it here and restart: discovery
# mode ends and the bot starts working in that chat.
ALLOWED_CHAT_ID=

# OpenRouter key for the LLM calls. Before going live, set a credit limit on the key in the
# OpenRouter dashboard: if the budget fuse ever fails, nothing else bounds the spending.
OPENROUTER_API_KEY=

# Google Places API key. Needed only by the offline `python -m sotto.places_fill`
# (venue cache); leave empty otherwise.
GOOGLE_PLACES_KEY=

# Path of the SQLite database inside the container. Defaults to data/bot.db; data/ is
# mounted as a volume in docker-compose.yml.
DB_PATH=

# Directory of the persona pack: pack.yaml, config.yaml, few_shot.yaml, fragments.yaml,
# stickers.yaml, places_manual.yaml, prompts/ ... (`python -m sotto.packcheck <dir>` validates a
# pack; see docs/creating-a-persona.md). Required: without it the process does not start
# (fail-closed, so that a lost mount cannot start another persona in the real chat). The old
# variables CONFIG_PATH, FEW_SHOT_PATH, PROMPT_PATH, *_PROMPT_PATH, STICKERS_PATH and
# CHANGELOG_PATH are no longer read: if one is set, a WARNING is logged at start and the
# value is ignored.
PERSONA_DIR=

# true allows the demo persona from personas/demo to start when PERSONA_DIR is not set
# (a local trial). Do not set it in production.
ALLOW_DEMO_PERSONA=

# Coordinates of the home point: the weather that goes as background into every system
# prompt is taken from them. They are deliberately in neither config.yaml nor the code: the
# repository may be public and these are the owner's personal data. Empty (or only one of the
# two filled) turns the home weather off and logs a WARNING at start; the weather for a place
# someone asks about in the chat still works. No API key is needed (the source, Open-Meteo,
# is public). WEATHER_HOME_NAME is the name of the home town; it is not put into the prompt,
# it only keeps the bot from adding a second weather line when someone asks about its own town.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_HOME_NAME=

# Log level: DEBUG | INFO | WARNING | ERROR. Defaults to INFO.
LOG_LEVEL=
