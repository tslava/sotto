# Скопировать в .env и заполнить. .env никогда не коммитится и не едет через CI.

# Токен бота из BotFather (/newbot). Обязателен.
BOT_TOKEN=

# Telegram user_id владельца (числом). Пока не используется на этапе 1,
# понадобится для команд управления (этап 6) и личных сообщений владельцу.
ADMIN_USER_ID=

# ID группового чата, в котором боту разрешено работать. Все сообщения из
# любого другого чата отбрасываются до записи в БД и до вызова модели.
#
# Discovery mode: пока значение 0 (или не задано), бот НИЧЕГО не пишет в БД
# и ни на что не отвечает — только логирует уровнем WARNING chat_id, название
# чата, user_id и display_name каждого входящего сообщения. Добавьте бота
# в целевой чат, напишите туда что-нибудь, найдите в логе первого запуска
# нужный chat_id, впишите его сюда и перезапустите бота — после этого
# discovery mode выключается и бот начинает работать в этом чате.
ALLOWED_CHAT_ID=

# Ключ OpenRouter для вызовов LLM. Перед выкатом обязательно выставить
# credit limit на ключе в личном кабинете OpenRouter — иначе при сбое
# предохранителя бюджет ничем не ограничен.
OPENROUTER_API_KEY=

# Ключ Google Places API. Нужен только с этапа 5 (заведения), можно оставить
# пустым до тех пор.
GOOGLE_PLACES_KEY=

# Путь к файлу базы SQLite внутри контейнера. По умолчанию data/bot.db —
# каталог data/ смонтирован volume'ом в docker-compose.yml.
DB_PATH=

# Каталог пакета персоны: config.yaml, few_shot.yaml, stickers.yaml, places_manual.yaml,
# prompts/ и pack.yaml (python -m sotto.packcheck <каталог> проверяет пакет). Обязателен:
# без него процесс не стартует (fail-closed, чтобы потерянный монтаж не запустил чужую
# персону в настоящем чате). Прежние переменные CONFIG_PATH, FEW_SHOT_PATH, PROMPT_PATH,
# *_PROMPT_PATH, STICKERS_PATH, CHANGELOG_PATH больше не читаются: если они заданы,
# на старте в лог уйдёт WARNING, значение игнорируется.
PERSONA_DIR=

# true — разрешить запуск демо-персоны из personas/demo, если PERSONA_DIR не задан
# (локальная проба). На проде не выставлять.
ALLOW_DEMO_PERSONA=

# Координаты домашней точки: из них берётся погода, которая уходит фоном в каждый
# системный промпт. В config.yaml и в коде их нет намеренно — репозиторий публичный,
# а это личные данные владельца. Пусто (или заполнено только одно поле) — погода
# за окном выключена, в лог на старте уйдёт WARNING; погода по месту, про которое
# спросили в чате, при этом работает. Ключ API не нужен, источник (Open-Meteo)
# публичный. WEATHER_HOME_NAME — название домашнего города (например, столицы
# вашего региона); в текст промпта оно не подставляется, а нужно только чтобы бот
# не выдавал вторую строку про погоду, когда спросили про его же город.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_HOME_NAME=

# Уровень логирования: DEBUG | INFO | WARNING | ERROR. По умолчанию INFO.
LOG_LEVEL=
